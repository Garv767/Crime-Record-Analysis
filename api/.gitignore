# =============================================================================
# Crime Record API — Go .gitignore
# =============================================================================

# Compiled binaries & test outputs
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go vendor directory (we use go modules instead)
vendor/

# Environment variables — contains DB credentials, never commit
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
