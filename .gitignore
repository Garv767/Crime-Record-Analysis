# =============================================================================
# Crime Record & Pattern Analysis — Root .gitignore
# =============================================================================

# ---- Go (api/) ---------------------------------------------------------------
api/bin/
api/*.exe
api/*.test
api/*.out
api/vendor/

# ---- Environment Variables (NEVER commit secrets) ----------------------------
.env
.env.*
!.env.example

# ---- Next.js (frontend/) -----------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ---- OS & Editor -------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.swp
*.swo

# ---- Logs & Debug ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Deploy ------------------------------------------------------------------
.vercel