# =============================================================================
# Crime Record & Pattern Analysis — Root .gitignore
# =============================================================================

# ---- Build Artifacts ---------------------------------------------------------
*.exe
*.test
*.out
bin/

# ---- Environment Variables (NEVER commit secrets) ----------------------------
.env
.env.*
!.env.example

# ---- Next.js (frontend/) -----------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ---- OS & Editor -------------------------------------------------------------
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.swp
*.swo

# ---- Logs & Debug ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Deploy ------------------------------------------------------------------
.vercel
.claude/settings.json
.claude/skills/debug-issue.md
.claude/skills/explore-codebase.md
.claude/skills/refactor-safely.md
.claude/skills/review-changes.md
.cursor/mcp.json
.cursorrules
.mcp.json
.opencode.json
.windsurfrules
AGENTS.md
CLAUDE.md
GEMINI.md

# Local Netlify folder
.netlify
